// Рассчитывает итоговую сумму заказа по строкам товаров.
Функция СуммаЗаказа(Товары) Экспорт
    Итого = 0;
    Для Каждого СтрокаТовара Из Товары Цикл
        Итого = Итого + СтрокаТовара.Сумма;
    КонецЦикла;
    Возврат Итого;
КонецФункции

// Проверяет остатки товаров на складе перед проведением.
Функция ПроверитьОстаткиТоваров(Товары, Склад) Экспорт
    Возврат Истина;
КонецФункции

// Получает валюту договора покупателя.
Функция ПолучитьВалютуДоговора(Договор) Экспорт
    Возврат Договор.Валюта;
КонецФункции

// Рассчитывает скидку по категории клиента.
Функция РассчитатьСкидкуКлиента(Клиент) Экспорт
    Возврат Клиент.ПроцентСкидки;
КонецФункции

// Преобразует сумму в валюту регламентированного учета.
Функция ПересчитатьСуммуВВалюту(Сумма, Курс) Экспорт
    Возврат Сумма * Курс;
КонецФункции

// Возвращает номер следующего заказа.
Функция СледующийНомерЗаказа() Экспорт
    Возврат 1;
КонецФункции
