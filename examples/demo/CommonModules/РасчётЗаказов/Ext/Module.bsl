// Расчёт итоговой суммы по строкам заказа.
// Параметры:
//  Товары — табличная часть заказа.
// Возвращаемое значение:
//  Число — сумма всех строк.
Функция СуммаЗаказа(Товары) Экспорт

	Итого = 0;
	Для Каждого СтрокаТовара Из Товары Цикл
		Итого = Итого + СтрокаТовара.Сумма;
	КонецЦикла;

	Возврат Итого;

КонецФункции
